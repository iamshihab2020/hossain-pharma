# Server Configuration
PORT=3000

# MongoDB Configuration
# Option 1: Use full connection URI (recommended)
MONGODB_URI=mongodb+srv://username:password@your-cluster.mongodb.net/?retryWrites=true&w=majority

# Option 2: Use individual variables (if MONGODB_URI is not set)
# DB_USER=your_mongodb_username
# DB_PASS=your_mongodb_password
# DB_CLUSTER=your-cluster.abcde.mongodb.net

# Database name (defaults to "hossain_Pharma" if not set)
DB_NAME=hossain_Pharma

# JWT Configuration
# Secret key used to sign JWT tokens (use a strong random string)
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here

# Stripe Configuration
# Use your Stripe SECRET key (sk_test_* or sk_live_*)
# NOT the publishable key - that goes in the frontend
STRIPE_SECRET=sk_test_your_stripe_secret_key
