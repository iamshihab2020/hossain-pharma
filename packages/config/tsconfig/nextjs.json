{
  "extends": "./base.json",
  "compilerOptions": {
    // Relaxed for the frontend only. The 32 salvaged shadcn/ui primitives are
    // written in the upstream shadcn style, which passes `foo={maybeUndefined}`
    // into props typed as required-optional. shadcn itself does not compile
    // under exactOptionalPropertyTypes, and any primitive regenerated by the
    // shadcn CLI would reintroduce the errors. The backend packages, whose code
    // we actually own, keep it on via tsconfig/node.json.
    "exactOptionalPropertyTypes": false,
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }]
  }
}
