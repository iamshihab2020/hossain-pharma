# API Configuration
# Points to the Express.js backend (old-code/server-side)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Firebase Configuration
# Copy values from old-code/client-side/.env (VITE_* variables)
NEXT_PUBLIC_FIREBASE_API_KEY=           # from VITE_APIKEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=       # from VITE_AUTHDOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=        # from VITE_PROJECTID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=    # from VITE_STORAGEBUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=  # from VITE_MESSAGINGSENDERID
NEXT_PUBLIC_FIREBASE_APP_ID=            # from VITE_APPID

# Stripe Configuration
# Use the publishable key (pk_*), NOT the secret key
# The secret key (sk_*) stays on the server-side only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # pk_test_* or pk_live_*
