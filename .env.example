# ---------------------------------------------------------------------------
# NexMarket - environment contract
#
# Copy to .env and adjust. Every variable here is validated at startup by zod;
# a missing or malformed value fails the boot rather than surfacing at runtime.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# NOTE the non-default port 5433. Host ports are shifted so this project can
# run alongside others that already bind 5432/6379. See docker-compose.yml.
#
# The APPLICATION connects as nexmarket_app: a role WITHOUT bypassrls, so RLS
# policies actually apply. See PRD section 6.3 and docs/architecture/0003.
DATABASE_URL=postgres://nexmarket_app:nexmarket_dev_password@localhost:5433/nexmarket

# MIGRATIONS connect as the owner, which needs DDL rights the app role
# deliberately lacks. On Neon this is the neondb_owner connection string.
DATABASE_MIGRATION_URL=postgres://postgres:postgres@localhost:5433/nexmarket

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6380

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0

# --- Identity (PRD 13) ------------------------------------------------------
# REPLACE BOTH SECRETS IN ANY DEPLOYED ENVIRONMENT. These are development
# placeholders and are in version control; anything signed with them is forgeable
# by anyone who has cloned the repo. Minimum 32 characters - the zod schema
# rejects shorter values at boot rather than at request time.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32char

# 15 minutes. Access tokens are not revocable, so this is the blast radius of a
# stolen one; revocation happens at the refresh boundary against `sessions`.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

COOKIE_DOMAIN=localhost
# Must be `true` in any environment served over HTTPS. Parsed as a literal
# string, so `false` really is false.
COOKIE_SECURE=false

# --- Google OAuth (optional) ------------------------------------------------
# Unset means the Google routes are not registered. Password login still works.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Where the OAuth callback sends the browser once the session cookie is set.
# A single fixed destination, never a caller-supplied ?redirect= - that is an
# open redirect on a route that has just minted a session.
WEB_APP_URL=http://localhost:3000

# --- Seller documents (PRD 9.2 step 4) --------------------------------------
# Where the local file-storage adapter writes uploaded KYC documents. Phase 1 is
# mock KYC on the local filesystem; object storage and signed URLs replace the
# adapter behind the same port. See docs/architecture/0010.
FILE_STORAGE_DIR=.nexmarket/uploads

# --- Web --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# --- Legacy Mongo (ETL only, optional) --------------------------------------
# Only needed to run scripts/mongo-etl. Leave unset otherwise.
# LEGACY_MONGO_URL=mongodb://localhost:27017
# LEGACY_MONGO_DB=hossainPharma

# --- Payments (PRD 10.1) ---
# Signs gateway webhooks. Minimum 32 bytes: this signature is the only thing
# between an anonymous POST and a ledger entry saying a buyer paid.
PAYMENT_WEBHOOK_SECRET=nexmarket-dev-webhook-secret-change-me
